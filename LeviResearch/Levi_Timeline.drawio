                </mxCell>
                <UserObject event_date="1822-01-01" event_end_date="1822-12-31" date_label="1822 - exact date not supplied" location="Sherbrooke settlement, Nova Scotia" name_as_recorded="Levi DeMill" evidence_type="Reported land-grant entry" source_shape_ids="[&quot;lead-grant&quot;]" source_files="[&quot;research_notes/Gmail - genealogical research query.pdf&quot;, &quot;research_notes/LeviNotes.txt&quot;]" link="research_notes/Gmail - genealogical research query.pdf" citation="Gmail - genealogical research query.pdf, page 3: RG 20 A, Ross, William (Lieut.) &amp; Others, 1822. The entry is identified as a draft grant; the card does not assert a date of settlement or possession." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;1822 - exact date not supplied&lt;/b&gt;&lt;br&gt;Sherbrooke settlement, Nova Scotia&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Levi DeMill&lt;/b&gt;&lt;br&gt;Allen Robertson&amp;#x27;s research, quoted in the family notes, lists Levi DeMill for 200 acres in the Ross and others draft grant. The original grant papers are not held.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Reported land-grant entry &amp;middot; &lt;a href=&quot;research_notes/Gmail - genealogical research query.pdf&quot;&gt;RG 20 A: Ross &amp;amp; others&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Gmail - genealogical research query.pdf, page 3: RG 20 A, Ross, William (Lieut.) &amp; Others, 1822. The entry is identified as a draft grant; the card does not assert a date of settlement or possession.&#xa;&#xa;Supporting files:&#xa;research_notes/Gmail - genealogical research query.pdf&#xa;research_notes/LeviNotes.txt" id="event-grant">
                    <mxCell style="rounded=0;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" parent="1" vertex="1">
