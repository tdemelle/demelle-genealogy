                <UserObject event_date="1826-04-18" event_end_date="1826-04-18" date_label="18 April 1826" location="St Stephen&#39;s Parish, Chester" name_as_recorded="Seven(?) Demel" evidence_type="Transcription held" source_shape_ids="[&quot;chester-1826&quot;, &quot;lead-original-marriage&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png" citation="Name is printed Seven(?) Demel in the supplied transcription; the uncertainty mark is retained. The original register image is not held. Walter&#39;s reported original reading differs and is not silently substituted." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;18 April 1826&lt;/b&gt;&lt;br&gt;St Stephen&amp;#x27;s Parish, Chester&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Seven(?) Demel&lt;/b&gt;&lt;br&gt;The transcription records a widower marrying Mary ann Wilneuf by banns, conducted by Rev. James Shreve. Witnesses: John Connor and Joseph Lordly. Both spouses are of the parish.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Transcription held &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s marriages&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Name is printed Seven(?) Demel in the supplied transcription; the uncertainty mark is retained. The original register image is not held. Walter&#39;s reported original reading differs and is not silently substituted.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png" id="event-second-marriage">
                    <mxCell parent="1" style="rounded=1;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" vertex="1">
                        <mxGeometry height="240" width="320" x="8332.31592975045" y="-1790" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject event_date="1831-06-01" event_end_date="1831-06-01" date_label="1 June 1831" location="Chester (family residence in record)" name_as_recorded="Levi Dimmell" evidence_type="Birth recorded in baptism transcription" source_shape_ids="[&quot;chester-1833&quot;, &quot;lead-original-baptism&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" citation="Supplied 1833 baptism transcription, March 13 entry: born June 1, 1831, son of Levi and Mary ann Dimmell; Chester, Farmer." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;1 June 1831&lt;/b&gt;&lt;br&gt;Chester (family residence in record)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Levi Dimmell&lt;/b&gt;&lt;br&gt;Peter Levi&amp;#x27;s baptism entry records this birth date and names his parents as Levi and Mary ann Dimmell. Levi is described as a farmer. The birthplace is not separately stated.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Birth recorded in baptism transcription &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s baptisms&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Supplied 1833 baptism transcription, March 13 entry: born June 1, 1831, son of Levi and Mary ann Dimmell; Chester, Farmer.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" id="event-son-birth">
                    <mxCell parent="1" style="rounded=1;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" vertex="1">
                        <mxGeometry height="240" width="320" x="8703.998472971914" y="-1810" as="geometry"/>
                    </mxCell>
                </UserObject>
                <UserObject event_date="1833-03-13" event_end_date="1833-03-13" date_label="13 March 1833" location="St Stephen&#39;s Parish, Chester" name_as_recorded="Levi Dimmell" evidence_type="Transcription held" source_shape_ids="[&quot;chester-1833&quot;, &quot;lead-original-baptism&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" citation="March 13 entry in the supplied baptism transcription; full parish identification supported by the associated marriage transcription and research notes." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;13 March 1833&lt;/b&gt;&lt;br&gt;St Stephen&amp;#x27;s Parish, Chester&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Levi Dimmell&lt;/b&gt;&lt;br&gt;Peter Levi, son of Levi and Mary ann Dimmell, is recorded as baptized by Rev. James Shreve. The entry also records the child&amp;#x27;s 1831 birth and the father&amp;#x27;s occupation as farmer.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Transcription held &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s baptisms&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="March 13 entry in the supplied baptism transcription; full parish identification supported by the associated marriage transcription and research notes.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" id="event-son-baptism">
                    <mxCell parent="1" style="rounded=1;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" vertex="1">
                        <mxGeometry height="240" width="320" x="9099.996647109441" y="-1810" as="geometry"/>
                    </mxCell>
