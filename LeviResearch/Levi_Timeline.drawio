                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;December 29th, 1813&lt;br&gt;Guernsey&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;br&gt;arrived at battalion headquarters in Guernsey&amp;nbsp;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;" vertex="1" parent="1">
