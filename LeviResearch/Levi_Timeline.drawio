                    <mxGeometry x="3980.5482281154664" y="1366" width="8" height="8" as="geometry"/>
                </mxCell>
                <UserObject event_date="1821-02-20" event_end_date="1821-02-20" date_label="20 February 1821" location="Sherbrook / Chester (residences)" name_as_recorded="Liven Demal" evidence_type="Reported diary entry" source_shape_ids="[&quot;lead-first-marriage&quot;]" source_files="[&quot;research_notes/Notes- Marriage info Levi Dimmell.docx&quot;]" link="research_notes/Notes- Marriage info Levi Dimmell.docx" citation="Walter DeMelle&#39;s notes, section 3, from his 2003 Nova Scotia research: The Diary and Related Writings of the Reverend Joseph Dimock (1768-1846), page 123. Spelling follows the cited diary reading, not a harmonised family name." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;20 February 1821&lt;/b&gt;&lt;br&gt;Sherbrook / Chester (residences)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Liven Demal&lt;/b&gt;&lt;br&gt;Walter cites Dimock&amp;#x27;s diary, page 123: marriage to Elizabeth Refus of Chester; Liven Demal is described as of Sherbrook. The ceremony location is not established by the note.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Reported diary entry &amp;middot; &lt;a href=&quot;research_notes/Notes- Marriage info Levi Dimmell.docx&quot;&gt;Dimock diary, p. 123 (cited)&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Walter DeMelle&#39;s notes, section 3, from his 2003 Nova Scotia research: The Diary and Related Writings of the Reverend Joseph Dimock (1768-1846), page 123. Spelling follows the cited diary reading, not a harmonised family name.&#xa;&#xa;Supporting files:&#xa;research_notes/Notes- Marriage info Levi Dimmell.docx" id="event-first-marriage">
                    <mxCell style="rounded=0;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" parent="1" vertex="1">
