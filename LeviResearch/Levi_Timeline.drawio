                    <mxGeometry height="83" width="225.45" x="7.27" y="127" as="geometry"/>
                </mxCell>
                <mxCell id="KvQJ0M6JbZ27sHgVb2HI-12" parent="KvQJ0M6JbZ27sHgVb2HI-10" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/jpeg,;rounded=1;" value="" vertex="1">
