                <UserObject event_date="1831-06-01" event_end_date="1831-06-01" date_label="1 June 1831" location="Chester (family residence in record)" name_as_recorded="Levi Dimmell" evidence_type="Birth recorded in baptism transcription" source_shape_ids="[&quot;chester-1833&quot;, &quot;lead-original-baptism&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" citation="Supplied 1833 baptism transcription, March 13 entry: born June 1, 1831, son of Levi and Mary ann Dimmell; Chester, Farmer." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;1 June 1831&lt;/b&gt;&lt;br&gt;Chester (family residence in record)&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Levi Dimmell&lt;/b&gt;&lt;br&gt;Peter Levi&amp;#x27;s baptism entry records this birth date and names his parents as Levi and Mary ann Dimmell. Levi is described as a farmer. The birthplace is not separately stated.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Birth recorded in baptism transcription &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s baptisms&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Supplied 1833 baptism transcription, March 13 entry: born June 1, 1831, son of Levi and Mary ann Dimmell; Chester, Farmer.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" id="event-son-birth">
                    <mxCell style="rounded=0;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" parent="1" vertex="1">
                        <mxGeometry x="8965.438472971915" y="1035" width="320" height="240" as="geometry"/>
                    </mxCell>
