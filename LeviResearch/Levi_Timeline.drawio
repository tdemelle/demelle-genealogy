    <diagram id="su0QEEOfObUCnsoVIJAg" name="Page-1">
        <mxGraphModel dx="1329" dy="1638" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="15" style="edgeStyle=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="2" target="14">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="2" value="&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 14px;&quot;&gt;December 16, 1813&lt;br&gt;Fort Cumberland, Eastney, Portsmouth&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Demel, Lewen&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;private, 7th Battalion, 60th Regiment of Foot, Company 9&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&quot;vol from Pris of War;&quot;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Enlisted by Capt. Marschalck out of the POW depot at Portsmouth&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=3;" vertex="1" parent="1">
                    <mxGeometry x="545" y="60" width="235" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="4" style="edgeStyle=none;html=1;" edge="1" parent="1" source="3" target="2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;PANS: Military Papers H.Q.O. (Microfilm Reel #9216)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;a.) Regiments and Corps&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;c.) Dates of Arrival&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;60th Reg. 7th Batt. arrival: 28 May 1814&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;departure: Drafted into 2nd and 3rd Battalions&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;p.15&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;60th Foot Regiment 7th Battalion&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; arrival: 28 May 1814 from Europe&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;background-color: transparent; white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&amp;nbsp; departure: 25 August for Castine&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: rgb(63, 63, 63);&quot;&gt;The first entry for him is the most interesting - he is noted as being present from 16th December 1813 - and his entry is annotated &#39;vol from Pris of War;&#39; together with the 2 men below him [and many others in the ledger].&amp;nbsp; In this list he&#39;s given as &#39;Demel, Lewen&#39;, but I&#39;m pretty sure this must be him.&amp;nbsp; I&#39;m pretty sure the bracket includes him as well as the 2 following men, but I don&#39;t know what the comment &#39;as no 5&#39; against all 3 of them means.&amp;nbsp; I could possibly investigate this further by taking another look at the paylists.&amp;nbsp; In subsequent paylists he appears as &#39;Leven Demell&#39;, &#39;Luen Demi&#39;, &#39;Lewin Demel&#39;, &#39;Leven Demell&#39;, &#39;Lew. Demel&#39;,.&amp;nbsp; The spelling finally settles dwon to &#39;Leven Demell&#39;.&lt;/span&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="470" y="330" width="320" height="410" as="geometry"/>
                </mxCell>
                <mxCell id="5" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;I followed him into the next set of paylists in WO12/7089, but abandoned photographing every entry, until I got to the quarter when the 7th btn was disbanded (Mar - Jun 1817).&amp;nbsp; Here Leven is annotated with a check mark with 2 lines through it; Notes on the paylist say that &#39;men checked out thus ..are charged sub[sequentl]y in 3d B[atallio]n 60th per Return voucher 6 of P[ay] L[ist] to Sep 17 of that Bn&#39;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;The Paylists for the 3rd Batallion are filed after this, but I could not see Leven listed there.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;there was a British internment camp on Halifax, which is were Leven was presumably a Prisoner of War until he volunteered for the 60th Foot.&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="865" y="330" width="320" height="310" as="geometry"/>
                </mxCell>
                <mxCell id="6" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;https://www.cairn.info/revue-napoleonica-la-revue-2014-3-page-118.htm#&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; The Release of Prisoners of War from Britain in 1813 and 1814&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;The decisive defeat of Napoleon at the Battle of Leipzig in 1813 convinced many of his German allies to throw in their lot with the Coalition forces.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;With the large numbers of Germans and Italians in the prison depots who were being conscripted into the forces arrayed against Napoleon, this was seen as potentially a serious problem.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;There were already such nationalities being held at Valleyfield, so by August 1812 there were at least 641 Italians and 588 Germans collected at the depot.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;The only choice these men were given was that of which force they could join. From Valleyfield they enlisted into the King’s German Legion, the 1st Dutch Regiment and most of the Italians into the army of the King of Sardinia.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;British Prison Depots: Dartmoor, Plymouth, Stapleton, Norman Cross, Chatham, Portchester, Portsmouth, Valleyfield, Perth&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="-490" y="310" width="420" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;British TNA : Paylists for the 7th battalion of the 60th Foot, Levi&#39;s listed, and was there from 16 Dec 1813 until the 7th btn disbanded in 1817&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;From Ruth Bloom: I have the 60th Foot stationed in Halifax in December 1813 - pre-dating when these notes [below] say they arrived from Europe.&amp;nbsp; A Wikipedia search confirms that part of the 60th Foot was involved in the Capture of Castine, but I believe this was a detachment, as the main body of the regiment remained in Halifax, including Levi.&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="80" y="330" width="340" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="8" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;SETTLEMENT&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Regarding the circumstances of land grant, I located the following document (VF v. 139, #26):&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;&quot;Military Settlements in Nova Scotia After the War of 1812&quot;, J.S. Martell, &quot;read before the Nova Scotia&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Historical Society, January 8, 1937&quot; [in &quot;Collections of the Nova Scotia Historical Society&quot;. p. 75-105]&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;A portion of the text reads:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;(p. 93)&quot;In the meantime, about fifty Germans of the 7th battalion of the 60th had expressed their desire to settle&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;in Lunenberg county.&amp;nbsp; these men had fought with Wellington in Europe and with Sherbrooke at Castine, and&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Dalhousie decided that he had no hesitation in suggesting that they receive a share of His Majesty&#39;s bounty.&quot;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;(p. 102)&quot;The Germans of the 60th, or those who remained, were not ready until the second grant was made up in 1821.&amp;nbsp; The grant of six thousand nine hundred acres, which went into effect in January, 1822, happily names the corps to which each man formerly belonged.&amp;nbsp; Of the forty-five grantees, twenty-four had been in the Nova Scotia Fencibles (two of them had appeared on the previous grant), four in the Royal Artillery, two in the Newfoundland Fencibles, and one in the 76th.&amp;nbsp; There were also two civilians, one the son of Captain Ross.&amp;nbsp; From the foregoing, it would appear that 109 soldiers were confirmed in the possession of the nineteen thousand nine hundred acres in Sherbrooke.&quot;&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="1250" y="300" width="390" height="510" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Research conducted in Nova Scotia Archives in 2000 by Allen Robertson commissoned by Todd DeMelle&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;RG 20 &quot;A&quot;: Post-1800 [Land Grant Papers]: DeMill, Levi ---see: Ross, William (Lieut.) &amp;amp; Others 1822&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;---Ross, William (Lieut.) &amp;amp; Others 1822: .... Draft Grant: to military settlers at Sherbrooke Settlement, 6900 acres of land in Lunenberg and Kings Counties.&amp;nbsp; [Includes several German names: ... eg. Kiens, Graff, Clotiz, Shipain, Hession]: .... Levi DeMill-- 200 acres.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;***The Men checked out thus (*) are charged&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&#39;men checked out thus ..are charged sub[sequentl]y in 3d B[atallio]n 60th per Return voucher 6 of P[ay] L[ist] to Sep 17 of that Bn&#39;&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="1730" y="310" width="390" height="340" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;August 3, 2019 From Walter DeMelle&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Notes (random) regarding possible clues to Levi Dimmell settlement in N.S.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;SOURCE:&amp;nbsp; http://www.theshipslist.com/ships/Arrivals/novascotia.shtml&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;appendix: Immigration to and Emigration from Nova Scotia 1815-1838 prepared by J.S. Martell, 1942&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Disbanded Soldiers &amp;amp; Pensioners&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;J.S. Martell, &quot;Military Settlements in Nova Scotia after the War of 1812,&quot; The Nova Scotia Historical Society, Collections, Vol. 24&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;The Royal Newfoundland Fencibles were disbanded at Halifax in June 1816. Two captains, five lieutenants, one ensign, one quarter-master, seven sergeants, and eighty-three of the rank and file, 99 in all, accepted the offer of free land in Nova Scotia. Most of them went to the new military settlement laid out for them at Sherwood and Sherbrooke (now New Ross) in Lunenburg County.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;The Nova Scotia Fencibles were disbanded at Halifax in July, 1816. Led by Captain William Ross, 172 of them are said to have arrived at Sherbrooke on August 7, 1816&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;J.S. Martell, op. cit. p.93 ff&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;More disbanded soldiers were placed along the projected Halifax-Annapolis Road in 1817. In April of the year, Surveyor-General Morris wrote to Captain Ross of Sherbrooke: &quot;You may soon expect —Many Setlers [sic] Germans and Highlanders on your Road between Gold River and Annapolis . . . &quot; In the same month Dalhousie asked Lord Bathurst for permission (received) to grant free land to about 50 Germans of the 7th Batt., 60th Regiment. Another military settlement on this road, Dalhousie, seems to have been started late in 1817.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;28 May 1814&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;60th Foot Reg. 7th Batt. King&#39;s German Legion&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Departure: drafted into 2nd and 3rd Battalions&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Formation of the 7th battalion&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;https://www.jstor.org/stable/44224645?read-now=1&amp;amp;seq=8#page_scan_tab_contents&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;25 Aug 1814&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Departure for Castine&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;http://www.fortwiki.com/Fort_Sherbrooke_(2)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;mentions Fort Sherbrooke near Castine, ME in 1814.&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="2190" y="310" width="480" height="830" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Thank you again, Ruth,&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; I consider ruling things out progress!&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; Would you say we have effectively ruled out that Leven was a POW in Halifax?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; The POW register dealing with German POWs in TNA and on FMP that you mention is for prisoners in Europe?&amp;nbsp; Does it specify which depots it covers?&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; I came across this article searching online which I found interesting for context and perhaps clues...&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; The Release of Prisoners of War from Britain in 1813 and 1814&amp;nbsp; https://www.cairn.info/revue-napoleonica-la-revue-2014-3-page-118.htm#&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Here are some excerpts I found interesting...&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;The decisive defeat of Napoleon at the Battle of Leipzig in 1813 convinced many of his German allies to throw in their lot &lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;with the Coalition forces.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;With the large numbers of Germans and Italians in the prison depots who were being conscripted into the forces arrayed against Napoleon, this was seen as potentially a serious problem.&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;There were already such nationalities being held at Valleyfield, so by August 1812 there were at least 641 Italians and 588 Germans collected at the depot.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;The only choice these men were given was that of which force they could join. From Valleyfield they enlisted into the King’s German Legion, the 1st Dutch Regiment and most of the Italians into the army of the King of Sardinia.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Some of the specific British Prison Depots mentioned in the article include: Dartmoor, Plymouth, Stapleton, Norman Cross, Chatham, Portchester, Portsmouth, Valleyfield, Perth&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Would specific depots perhaps have registries of prisoners somewhere that can be searched?&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;I think looking at the 1813 KGL records is worth a shot!&amp;nbsp; With so few straws left, I don&#39;t mind a little grasping.&amp;nbsp; One more try!&amp;nbsp; If it&#39;s 4 more hours to be exhaustive, so be it.&amp;nbsp; He has to have been a POW somewhere!&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;I imagine this is familiar to you, but just to be thorough, I came across TNA guidelines for searching for POWs up to 1855 from http://www.nationalarchives.gov.uk/help-with-your-research/research-guides/prisoners-of-war-british-hands/#6-prisoners-of-war-up-to-1855&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;There is no general index to prisoners, so searching for individuals may be hard.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Search our catalogue within ADM 97, ADM 105 and ADM 103 and refine by date.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;You can find:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; lists of prisoners, usually arranged by nationality or by place of confinement or parole, in ADM 103: these often include circumstances of their capture and eventual disposal – some of these are available on Findmypast (£)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; prisoners’ petitions in ADM 97&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; lists of PoW exchanges, for example WO 40/2 and WO 1/905-16&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; circumstances of capture and incarceration&amp;nbsp; in WO 1 and WO 4&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;An alphabetical list of American prisoners compiled by the University of Virginia is available at The National Archives and supplements a general register of American prisoners (1813) in ADM 6/417. Please note, ADM 6/417 is available on Findmypast (£).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;Browse lists of enemy prisoners on parole in Britain in HO 28. This is not indexed.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre; white-space: normal;&quot;&gt;&lt;font color=&quot;#000000&quot;&gt;&#x9;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Fingers crossed,&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;Todd&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;size=0.11904761904761904;" vertex="1" parent="1">
                    <mxGeometry x="350" y="1040" width="490" height="1040" as="geometry"/>
                </mxCell>
                <mxCell id="13" style="edgeStyle=none;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="12" target="2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="12" value="Prisoner held at POW Depot at Portsmouth&lt;br&gt;Search ADM 103 POW register" style="rounded=0;whiteSpace=wrap;html=1;strokeWidth=1;" vertex="1" parent="1">
                    <mxGeometry x="190" y="120" width="190" height="110" as="geometry"/>
                </mxCell>
