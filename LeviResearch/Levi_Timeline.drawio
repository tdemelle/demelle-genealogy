                </mxCell>
                <UserObject event_date="1833-03-13" event_end_date="1833-03-13" date_label="13 March 1833" location="St Stephen&#39;s Parish, Chester" name_as_recorded="Levi Dimmell" evidence_type="Transcription held" source_shape_ids="[&quot;chester-1833&quot;, &quot;lead-original-baptism&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" citation="March 13 entry in the supplied baptism transcription; full parish identification supported by the associated marriage transcription and research notes." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;13 March 1833&lt;/b&gt;&lt;br&gt;St Stephen&amp;#x27;s Parish, Chester&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Levi Dimmell&lt;/b&gt;&lt;br&gt;Peter Levi, son of Levi and Mary ann Dimmell, is recorded as baptized by Rev. James Shreve. The entry also records the child&amp;#x27;s 1831 birth and the father&amp;#x27;s occupation as farmer.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Transcription held &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s baptisms&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="March 13 entry in the supplied baptism transcription; full parish identification supported by the associated marriage transcription and research notes.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1833 chester bapt.png" id="event-son-baptism">
                    <mxCell style="rounded=0;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" parent="1" vertex="1">
                        <mxGeometry x="9678.416647109441" y="1035" width="320" height="240" as="geometry"/>
                    </mxCell>
                </UserObject>
