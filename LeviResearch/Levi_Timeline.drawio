                <UserObject event_date="1826-04-18" event_end_date="1826-04-18" date_label="18 April 1826" location="St Stephen&#39;s Parish, Chester" name_as_recorded="Seven(?) Demel" evidence_type="Transcription held" source_shape_ids="[&quot;chester-1826&quot;, &quot;lead-original-marriage&quot;]" source_files="[&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png&quot;]" link="primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png" citation="Name is printed Seven(?) Demel in the supplied transcription; the uncertainty mark is retained. The original register image is not held. Walter&#39;s reported original reading differs and is not silently substituted." label="&lt;div style=&quot;font-size:15px;line-height:19px&quot;&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;18 April 1826&lt;/b&gt;&lt;br&gt;St Stephen&amp;#x27;s Parish, Chester&lt;br&gt;&lt;br&gt;&lt;b style=&quot;font-size:22px;line-height:25px&quot;&gt;Seven(?) Demel&lt;/b&gt;&lt;br&gt;The transcription records a widower marrying Mary ann Wilneuf by banns, conducted by Rev. James Shreve. Witnesses: John Connor and Joseph Lordly. Both spouses are of the parish.&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Transcription held &amp;middot; &lt;a href=&quot;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png&quot;&gt;St Stephen&amp;#x27;s, Chester / St Stephen&amp;#x27;s marriages&lt;/a&gt;&lt;/span&gt;&lt;/div&gt;" tooltip="Name is printed Seven(?) Demel in the supplied transcription; the uncertainty mark is retained. The original register image is not held. Walter&#39;s reported original reading differs and is not silently substituted.&#xa;&#xa;Supporting files:&#xa;primary_sources/St_Stephens_Chester_transcriptions/transcription_1826 Chester marriages.png" id="event-second-marriage">
                    <mxCell style="rounded=0;strokeWidth=3;fontSize=15;spacingLeft=5;spacingRight=5;spacing=5;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#3F3F3F;" parent="1" vertex="1">
                        <mxGeometry x="6917.40592975045" y="1035" width="320" height="240" as="geometry"/>
                    </mxCell>
                </UserObject>
